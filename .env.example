# Copy to .env. Never commit .env. Leave a value empty to disable that integration.

APP_ENV=development
APP_BASE_URL=http://localhost:8000
# PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host:5432/worldpulse
DATABASE_URL=sqlite:///./worldpulse.db
DISPLAY_TIMEZONE=Asia/Kolkata
RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120

# Admin dashboard token (generate a long random value: python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=

# GNews: https://gnews.io (free plan is limited to 100 requests/day; check your plan terms)
GNEWS_API_KEY=
GNEWS_LANGUAGES=en
GNEWS_COUNTRIES=in
GNEWS_DAILY_REQUEST_LIMIT=100

# NewsAPI: https://newsapi.org (the developer plan is for development use only; confirm your plan allows production)
NEWSAPI_API_KEY=
NEWSAPI_COUNTRIES=in
NEWSAPI_DAILY_REQUEST_LIMIT=100

# LLM: any OpenAI-compatible chat endpoint. Without a key, extractive excerpts are shown and flagged.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Email (SMTP). Leave SMTP_HOST empty to skip email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
NOTIFY_RECIPIENTS=

# Supabase: not used by this version yet (see README, "Not yet built").
